# Dedicated, non-destructive BNO085 UART-RVC bridge build.
export PATH := /home/shay/a/ece270/bin:$(PATH)
export LD_LIBRARY_PATH := /home/shay/a/ece270/lib:$(LD_LIBRARY_PATH)
SHELL := bash
BUILD := build
TOP := top_bno_uart_bridge
RTL := rtl/top_bno_uart_bridge.sv
PCF := constraints/bno_uart_bridge.pcf
JSON := $(BUILD)/bno_uart_bridge.json
ASC := $(BUILD)/bno_uart_bridge.asc
BIN := $(BUILD)/bno_uart_bridge.bin
.PHONY: test bitstream cram

test:
	mkdir -p $(BUILD)
	iverilog -g2012 -s top_bno_uart_bridge_tb -o $(BUILD)/bno_uart_bridge_tb $(RTL) tb/top_bno_uart_bridge_tb.sv
	vvp $(BUILD)/bno_uart_bridge_tb

$(JSON): $(RTL)
	mkdir -p $(BUILD)
	yosys -q -p 'read_verilog -sv $(RTL); synth_ice40 -top $(TOP); delete t:$$scopeinfo; write_json $(JSON)'
$(ASC): $(JSON) $(PCF)
	nextpnr-ice40 --hx8k --package ct256 --pcf $(PCF) --json $(JSON) --asc $(ASC)
$(BIN): $(ASC)
	icepack $(ASC) $(BIN)
bitstream: $(BIN)
cram: $(BIN)
	iceprog -S $(BIN)
